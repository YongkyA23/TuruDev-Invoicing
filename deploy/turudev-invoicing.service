[Unit]
Description=TuruDev Invoicing
After=network-online.target mysql.service
Wants=network-online.target
Requires=mysql.service

[Service]
Type=simple
User=turudev-app
Group=turudev-app
WorkingDirectory=/var/www/turudev-invoicing/current
EnvironmentFile=/etc/turudev-invoicing/production.env
ExecStart=/usr/local/bin/node24 /var/www/turudev-invoicing/current/server/index.mjs
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/turudev-invoicing/backups

[Install]
WantedBy=multi-user.target
